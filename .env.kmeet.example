# Internal kMeet preprod host for a local preprod build:
#   set -a; source .env.kmeet; set +a
#   npm run build
#
# Copy this file to .env.kmeet (git-ignored) and fill in the real values.
# These hosts are internal Infomaniak infrastructure: never commit them, the
# repository is mirrored publicly.

# KMEET_PREPROD_HOST=kmeet-preprod.example.invalid

# Published @infomaniak packages install from GitHub Packages through the
# tracked .npmrc with an NPM_TOKEN env var — no repository change needed.
# Unpublished internal versions resolve through a user-level npm config
# (never this repository, it is mirrored publicly):
#   npm config set @infomaniak:registry https://registry.example.invalid --location=user
