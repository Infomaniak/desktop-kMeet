{
  "name": "kmeet-electron",
  "version": "1.1.18",
  "description": "Electron application for Infomaniak Meet",
  "main": "./build/main.js",
  "productName": "kMeet",
  "scripts": {
    "start": "webpack --config ./webpack.main.js --mode development && concurrently \"npm:watch\" \"electron ./build/main.js\"",
    "clean": "rm -rf node_modules build dist",
    "lint": "eslint . && flow",
    "build": "webpack --config ./webpack.main.js --mode production && webpack --config ./webpack.renderer.js --mode production",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "validate": "npm ls",
    "watch": "webpack --config ./webpack.renderer.js --mode development --watch --watch-poll",
    "publish": "npm run build && electron-builder -p always"
  },
  "build": {
    "appId": "com.infomaniak.meet",
    "productName": "kMeet",
    "generateUpdatesFilesForAllChannels": true,
    "afterSign": "scripts/notarize.js",
    "publish": {
      "provider": "s3",
      "channel": "latest",
      "bucket": "download",
      "endpoint": "https://leoupload.infomaniak.com",
      "path": "/meet"
    },
    "files": [
      "**/*",
      "resources",
      "!app",
      "!main.js"
    ],
    "dmg": {
      "sign": true
    },
    "mac": {
      "artifactName": "kMeet.${ext}",
      "category": "public.app-category.video",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Please give us access to your microphone",
        "NSCameraUsageDescription": "Please give us access to your camera",
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Viewer",
            "CFBundleURLSchemes": "kmeet"
          }
        ]
      }
    },
    "linux": {
      "artifactName": "kMeet-${arch}.${ext}",
      "category": "VideoConference;AudioVideo;Audio;Video;Network",
      "description": "Infomaniak Meet Desktop App",
      "mimeTypes": [
        "x-scheme-handler/kmeet"
      ],
      "desktop": {
        "MimeType": "x-scheme-handler/kmeet"
      },
      "maintainer": "Infomaniak",
      "executableName": "kMeet",
      "target": [
        {
          "arch": "x64",
          "target": "AppImage"
        }
      ]
    },
    "win": {
      "artifactName": "kMeet.${ext}",
      "certificateSubjectName": "INFOMANIAK NETWORK SA",
      "target": [
        {
          "arch": [
            "ia32",
            "x64"
          ],
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    },
    "directories": {
      "buildResources": "resources"
    },
    "protocols": {
      "name": "kmeet-protocol",
      "schemes": [
        "kmeet"
      ]
    }
  },
  "pre-commit": [
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git://gitlab.infomaniak.ch/infomaniak/jitsi-meet-electron"
  },
  "keywords": [
    "infomaniak",
    "kmeet"
  ],
  "author": "Infomaniak",
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "dependencies": {
    "@atlaskit/avatar": "14.1.7",
    "@atlaskit/button": "^10.1.1",
    "@atlaskit/css-reset": "3.0.5",
    "@atlaskit/droplist": "7.0.17",
    "@atlaskit/field-text": "7.0.19",
    "@atlaskit/icon": "15.0.3",
    "@atlaskit/navigation": "33.3.8",
    "@atlaskit/onboarding": "6.1.14",
    "@atlaskit/page": "8.0.12",
    "@atlaskit/spinner": "9.0.13",
    "@atlaskit/theme": "7.0.1",
    "@atlaskit/toggle": "5.0.14",
    "dotenv": "^8.2.0",
    "electron-debug": "3.0.1",
    "electron-is-dev": "1.2.0",
    "electron-log": "4.1.1",
    "electron-notarize": "1.0.0",
    "electron-reload": "1.5.0",
    "electron-store": "5.1.1",
    "electron-updater": "4.2.5",
    "electron-window-state": "5.0.3",
    "history": "4.7.2",
    "jitsi-meet-electron-utils": "file:jitsi-meet-electron-utils",
    "js-utils": "github:jitsi/js-utils#0c53500a5120be2aa3fc590f0f932a0d4771920f",
    "lodash": "4.17.21",
    "moment": "2.23.0",
    "mousetrap": "1.6.2",
    "react": "16.8.0",
    "react-dom": "16.8.0",
    "react-redux": "5.1.1",
    "react-router-redux": "5.0.0-alpha.9",
    "redux": "4.0.1",
    "redux-logger": "3.0.6",
    "redux-persist": "5.10.0",
    "redux-persist-electron-storage": "2.0.0",
    "source-map-support": "0.5.9",
    "styled-components": "3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-export-namespace-from": "^7.8.3",
    "@babel/plugin-transform-flow-strip-types": "^7.9.0",
    "@babel/preset-env": "7.2.0",
    "@babel/preset-flow": "7.0.0",
    "@babel/preset-react": "7.0.0",
    "babel-eslint": "10.0.3",
    "babel-loader": "8.0.4",
    "babel-plugin-inline-react-svg": "1.0.1",
    "concurrently": "4.1.0",
    "css-loader": "2.0.1",
    "devtron": "1.4.0",
    "electron": "10.1.6",
    "electron-builder": "22.7.0",
    "electron-react-devtools": "0.5.3",
    "eslint": "6.5.1",
    "eslint-config-jitsi": "github:jitsi/eslint-config-jitsi#1.0.2",
    "eslint-plugin-flowtype": "4.3.0",
    "eslint-plugin-import": "2.18.0",
    "eslint-plugin-jsdoc": "15.11.1",
    "eslint-plugin-react": "7.16.0",
    "file-loader": "2.0.0",
    "flow-bin": "0.109.0",
    "html-webpack-plugin": "3.2.0",
    "precommit-hook": "3.0.0",
    "style-loader": "0.23.1",
    "svg-inline-loader": "0.8.0",
    "webpack": "4.27.1",
    "webpack-cli": "3.1.2"
  }
}
