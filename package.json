{
  "name": "kmeet-desktop",
  "version": "2.0.1",
  "description": "Electron application for Infomaniak Meet",
  "main": "./build/main.js",
  "productName": "kMeet",
  "homepage": "https://infomaniak.com/kmeet",
  "private": true,
  "scripts": {
    "start": "node ./esbuild.js --dev && concurrently \"npm:watch\" \"electron ./build/main.js\"",
    "clean": "rm -rf node_modules build dist",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint-fix": "eslint . --ext .js,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "build": "npm run type-check && node ./esbuild.js",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:msi": "cross-env DISABLE_UPDATE=true npm run build && electron-builder --win msi --x64 --publish=never",
    "dist:nsis": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "patch-package",
    "watch": "node ./esbuild.js renderer --dev --watch",
    "validate": "npm ls",
    "test": "esbuild test/*.test.ts --bundle --platform=node --outdir=build/test --log-level=warning && mocha \"build/test/*.test.js\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git://gitlab.infomaniak.ch/infomaniak/jitsi-meet-electron"
  },
  "keywords": [
    "infomaniak",
    "kmeet"
  ],
  "author": "Infomaniak",
  "readmeFilename": "README.md",
  "license": "proprietary",
  "dependencies": {
    "@infomaniak/jitsi-meet-electron-sdk": "6.1.2",
    "@sentry/electron": "^4.10.0",
    "auto-launch": "^5.0.5",
    "electron-debug": "^3.2.0",
    "electron-log": "^4.3.2",
    "electron-reload": "^1.5.0",
    "electron-store": "^5.2.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.1.1",
    "jsonfile": "^6.1.0"
  },
  "devDependencies": {
    "@hapi/bourne": "^3.0.0",
    "@jitsi/eslint-config": "^6.0.4",
    "@jitsi/js-utils": "2.0.5",
    "@sentry/cli": "^2.20.7",
    "@sentry/webpack-plugin": "^2.7.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/mocha": "10.0.10",
    "@types/mousetrap": "^1.6.15",
    "@types/react": "^17.0.92",
    "@types/react-dom": "^17.0.26",
    "@types/react-redux": "^7.1.34",
    "@types/redux-logger": "^3.0.13",
    "@types/styled-components": "^5.1.36",
    "babel-eslint": "10.0.3",
    "concurrently": "5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "electron-context-menu": "^2.5.0",
    "electron-is-dev": "^1.2.0",
    "electron-notarize": "1.1.1",
    "electron-react-devtools": "0.5.3",
    "electron-to-chromium": "^1.5.364",
    "electron-window-state": "^5.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-react": "^7.37.0",
    "history": "^4.10.1",
    "i18next": "^19.9.2",
    "mocha": "^10.0.0",
    "moment": "^2.29.2",
    "mousetrap": "^1.6.5",
    "patch-package": "8.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.8.12",
    "react-redux": "^5.1.2",
    "react-router-redux": "^5.0.0-alpha.9",
    "redux": "^4.1.2",
    "redux-logger": "^3.0.6",
    "redux-persist": "^5.10.0",
    "source-map-support": "^0.5.19",
    "styled-components": "^3.4.10",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fbjs": "^3.0.5"
  }
}
