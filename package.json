{
  "name": "kmeet-electron",
  "version": "1.1.35",
  "description": "Electron application for Infomaniak Meet",
  "main": "./build/main.js",
  "productName": "kMeet",
  "scripts": {
    "start": "webpack --config ./webpack.main.js --mode development && concurrently \"npm:watch\" \"electron ./build/main.js\"",
    "clean": "rm -rf node_modules build dist",
    "lint": "eslint . && flow",
    "build": "webpack --config ./webpack.main.js --mode production && webpack --config ./webpack.renderer.js --mode production",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "validate": "npm ls",
    "watch": "webpack --config ./webpack.renderer.js --mode development --watch --watch-poll",
    "publish": "npm run build && electron-builder -p always"
  },
  "build": {
    "appId": "com.infomaniak.meet",
    "productName": "kMeet",
    "generateUpdatesFilesForAllChannels": true,
    "afterPack": "scripts/linux-sandbox-fix.js",
    "afterSign": "scripts/notarize.js",
    "publish": {
      "provider": "s3",
      "channel": "latest",
      "bucket": "download",
      "endpoint": "https://leoupload.infomaniak.com",
      "path": "/meet"
    },
    "files": [
      "**/*",
      "resources",
      "!app",
      "!main.js"
    ],
    "dmg": {
      "sign": true
    },
    "mac": {
      "artifactName": "kMeet.${ext}",
      "target": [
        {
          "arch": "x64",
          "target": "dmg"
        },
        {
          "arch": "x64",
          "target": "zip"
        }
      ],
      "category": "public.app-category.video",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "asarUnpack": "**/*.node",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "kMeet requires access to your camera in order to make video-calls.",
        "NSCameraUsageDescription": "kMeet requires access to your microphone in order to make calls (audio/video).",
        "LSMultipleInstancesProhibited": true,
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Viewer",
            "CFBundleURLSchemes": "kmeet"
          }
        ]
      }
    },
    "linux": {
      "artifactName": "kMeet-${arch}.${ext}",
      "category": "VideoConference;AudioVideo;Audio;Video;Network",
      "description": "Infomaniak Meet Desktop App",
      "mimeTypes": [
        "x-scheme-handler/kmeet"
      ],
      "desktop": {
        "MimeType": "x-scheme-handler/kmeet"
      },
      "maintainer": "Infomaniak",
      "executableName": "kMeet",
      "target": [
        {
          "arch": "x64",
          "target": "AppImage"
        }
      ]
    },
    "win": {
      "artifactName": "kMeet.${ext}",
      "certificateSubjectName": "INFOMANIAK NETWORK SA",
      "target": [
        {
          "arch": [
            "ia32",
            "x64"
          ],
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "include": "scripts/installer.nsh"
    },
    "directories": {
      "buildResources": "resources"
    },
    "protocols": {
      "name": "kmeet-protocol",
      "schemes": [
        "kmeet"
      ]
    }
  },
  "pre-commit": [
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git://gitlab.infomaniak.ch/infomaniak/jitsi-meet-electron"
  },
  "keywords": [
    "infomaniak",
    "kmeet"
  ],
  "author": "Infomaniak",
  "readmeFilename": "README.md",
  "license": "proprietary",
  "dependencies": {
    "@atlaskit/avatar": "14.1.7",
    "@atlaskit/button": "^10.1.3",
    "@atlaskit/css-reset": "3.0.8",
    "@atlaskit/droplist": "7.0.19",
    "@atlaskit/field-text": "7.1.0",
    "@atlaskit/icon": "15.0.3",
    "@atlaskit/navigation": "33.3.10",
    "@atlaskit/onboarding": "6.2.0",
    "@atlaskit/page": "8.0.12",
    "@atlaskit/panel": "^0.3.5",
    "@atlaskit/spinner": "9.0.13",
    "@atlaskit/theme": "7.0.5",
    "@atlaskit/toggle": "^5.0.15",
    "@jitsi/js-utils": "^1.0.6",
    "@sentry/electron": "^3.0.2",
    "auto-launch": "^5.0.5",
    "electron-context-menu": "^2.5.0",
    "electron-debug": "^3.2.0",
    "electron-is-dev": "^1.2.0",
    "electron-log": "^4.3.2",
    "electron-notarize": "1.0.0",
    "electron-reload": "^1.5.0",
    "electron-store": "^5.2.0",
    "electron-updater": "^4.3.8",
    "electron-window-state": "^5.0.3",
    "history": "4.7.2",
    "i18next": "^19.9.2",
    "jitsi-meet-electron-utils": "file:jitsi-meet-electron-utils",
    "lodash": "4.17.21",
    "moment": "^2.29.1",
    "mousetrap": "^1.6.5",
    "perfect-freehand": "^0.4.91",
    "polygon-clipping": "^0.15.3",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-i18next": "^11.8.12",
    "react-redux": "^5.1.2",
    "react-router-redux": "^5.0.0-alpha.9",
    "redux": "^4.0.5",
    "redux-logger": "^3.0.6",
    "redux-persist": "^5.10.0",
    "redux-persist-electron-storage": "^2.1.0",
    "source-map-support": "^0.5.19",
    "styled-components": "^3.4.10"
  },
  "devDependencies": {
    "@babel/core": "7.9.0",
    "@babel/plugin-proposal-class-properties": "7.8.3",
    "@babel/plugin-proposal-export-namespace-from": "7.8.3",
    "@babel/plugin-transform-flow-strip-types": "7.9.0",
    "@babel/preset-env": "7.9.0",
    "@babel/preset-flow": "7.9.0",
    "@babel/preset-react": "7.9.4",
    "@svgr/webpack": "5.4.0",
    "babel-eslint": "10.0.3",
    "babel-loader": "8.1.0",
    "babel-plugin-inline-react-svg": "1.0.1",
    "concurrently": "5.1.0",
    "css-loader": "3.5.0",
    "electron": "12.0.4",
    "electron-builder": "22.10.5",
    "@sentry/cli": "^1.73.0",
    "@sentry/webpack-plugin": "^1.18.8",
    "electron-react-devtools": "0.5.3",
    "eslint": "6.5.1",
    "eslint-config-jitsi": "github:jitsi/eslint-config-jitsi#1.0.2",
    "eslint-plugin-flowtype": "4.7.0",
    "eslint-plugin-import": "2.20.2",
    "eslint-plugin-jsdoc": "22.1.0",
    "eslint-plugin-react": "7.19.0",
    "file-loader": "6.0.0",
    "flow-bin": "0.109.0",
    "html-webpack-plugin": "4.0.4",
    "patch-package": "6.2.2",
    "style-loader": "1.1.3",
    "svg-inline-loader": "0.8.0",
    "webpack": "4.42.1",
    "webpack-cli": "3.3.11"
  }
}
