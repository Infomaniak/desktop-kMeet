{
  "name": "kmeet-electron",
  "version": "1.1.36",
  "description": "Electron application for Infomaniak Meet",
  "main": "./build/main.js",
  "productName": "kMeet",
  "scripts": {
    "start": "webpack --config ./webpack.main.js --mode development && concurrently \"npm:watch\" \"electron ./build/main.js\"",
    "clean": "rm -rf node_modules build dist",
    "lint": "eslint . && flow",
    "build": "webpack --config ./webpack.main.js --mode production && webpack --config ./webpack.renderer.js --mode production",
    "dist": "npm run build && electron-builder",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "watch": "webpack --config ./webpack.renderer.js --mode development --watch --watch-poll",
    "validate": "npm ls"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "build": {
    "appId": "com.infomaniak.meet",
    "productName": "kMeet",
    "generateUpdatesFilesForAllChannels": true,
    "afterPack": "scripts/linux-sandbox-fix.js",
    "afterSign": "scripts/notarize.js",
    "publish": {
      "provider": "s3",
      "channel": "latest",
      "bucket": "download",
      "endpoint": "https://leoupload.infomaniak.com",
      "path": "/meet"
    },
    "files": [
      "build",
      "resources",
      "!app",
      "!main.js"
    ],
    "dmg": {
      "sign": true
    },
    "mac": {
      "artifactName": "kMeet.${ext}",
      "target": [
        {
          "arch": "x64",
          "target": "dmg"
        },
        {
          "arch": "x64",
          "target": "zip"
        }
      ],
      "category": "public.app-category.video",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "asarUnpack": "**/*.node",
      "extendInfo": {
        "NSCameraUsageDescription": "kMeet requires access to your camera in order to make video-calls.",
        "NSMicrophoneUsageDescription": "kMeet requires access to your microphone in order to make calls (audio/video).",
        "LSMultipleInstancesProhibited": true
      }
    },
    "mas": {
      "entitlements": "resources/entitlements.mas.plist",
      "entitlementsInherit": "resources/entitlements.mas.inherit.plist",
      "hardenedRuntime": false
    },
    "linux": {
      "artifactName": "kMeet-${arch}.${ext}",
      "category": "VideoConference;AudioVideo;Audio;Video;Network",
      "description": "Infomaniak Meet Desktop App",
      "mimeTypes": [
        "x-scheme-handler/kmeet"
      ],
      "desktop": {
        "MimeType": "x-scheme-handler/kmeet"
      },
      "maintainer": "Infomaniak",
      "executableName": "kMeet",
      "target": [
        {
          "arch": "x64",
          "target": "AppImage"
        },
        {
          "arch": "x64",
          "target": "deb"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    },
    "win": {
      "artifactName": "kMeet.${ext}",
      "certificateSubjectName": "INFOMANIAK NETWORK SA",
      "target": [
        {
          "arch": [
            "ia32",
            "x64"
          ],
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "include": "scripts/installer.nsh"
    },
    "directories": {
      "buildResources": "resources"
    },
    "protocols": {
      "name": "kmeet-protocol",
      "role": "Viewer",
      "schemes": [
        "kmeet"
      ]
    }
  },
  "pre-commit": [
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git://gitlab.infomaniak.ch/infomaniak/jitsi-meet-electron"
  },
  "keywords": [
    "infomaniak",
    "kmeet"
  ],
  "author": "Infomaniak",
  "readmeFilename": "README.md",
  "license": "proprietary",
  "dependencies": {
    "@jitsi/electron-sdk": "file:jitsi-meet-electron-utils",
    "auto-launch": "^5.0.5",
    "electron-debug": "^3.2.0",
    "electron-json-config": "^2.0.0-beta",
    "electron-reload": "^1.5.0"
  },
  "devDependencies": {
    "@atlaskit/css-reset": "^3.0.8",
    "@atlaskit/field-text": "^7.1.0",
    "@atlaskit/icon": "^15.0.3",
    "@atlaskit/onboarding": "^6.2.0",
    "@atlaskit/spinner": "^9.0.13",
    "@atlaskit/theme": "^7.0.5",
    "@babel/core": "7.9.0",
    "@babel/plugin-proposal-class-properties": "7.8.3",
    "@babel/plugin-proposal-export-namespace-from": "7.8.3",
    "@babel/plugin-transform-flow-strip-types": "7.9.0",
    "@babel/preset-env": "7.9.0",
    "@babel/preset-flow": "7.9.0",
    "@babel/preset-react": "7.9.4",
    "@jitsi/js-utils": "2.0.0",
    "@svgr/webpack": "5.4.0",
    "babel-eslint": "10.0.3",
    "babel-loader": "8.1.0",
    "concurrently": "5.1.0",
    "css-loader": "3.5.0",
    "electron": "16.0.6",
    "electron-builder": "22.11.11",
    "electron-context-menu": "^2.5.0",
    "electron-is-dev": "^1.2.0",
    "electron-log": "^4.3.2",
    "electron-notarize": "1.1.1",
    "electron-react-devtools": "0.5.3",
    "electron-updater": "^4.3.9",
    "electron-window-state": "^5.0.3",
    "eslint": "6.5.1",
    "eslint-config-jitsi": "github:jitsi/eslint-config-jitsi#1.0.2",
    "eslint-plugin-flowtype": "4.7.0",
    "eslint-plugin-import": "2.20.2",
    "eslint-plugin-jsdoc": "22.1.0",
    "eslint-plugin-react": "7.19.0",
    "file-loader": "6.0.0",
    "flow-bin": "0.109.0",
    "history": "^4.10.1",
    "html-webpack-plugin": "4.0.4",
    "i18next": "^19.9.2",
    "moment": "^2.29.1",
    "mousetrap": "^1.6.5",
    "patch-package": "6.2.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-i18next": "^11.8.12",
    "react-redux": "^5.1.2",
    "react-router-redux": "^5.0.0-alpha.9",
    "redux": "^4.0.5",
    "redux-logger": "^3.0.6",
    "redux-persist": "^5.10.0",
    "source-map-support": "^0.5.19",
    "style-loader": "1.1.3",
    "styled-components": "^3.4.10",
    "webpack": "4.42.1",
    "webpack-cli": "3.3.11"
  }
}
